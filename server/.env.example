# Porta do servidor (o jogo chega por /api/* pelo proxy do scripts/live.ts / scripts/dev.ts)
PORT=3012
# Postgres (no autor: container postgres_16 do WSL, host 5433; banco próprio "villageninja")
DATABASE_URL=postgres://postgres:SENHA@localhost:5433/villageninja
# Banco dos testes (bun test): esvaziado a cada rodada; sem ele os testes do servidor são pulados
TEST_DATABASE_URL=postgres://postgres:SENHA@localhost:5433/villageninja_test
# Origens do jogo (CORS), separadas por vírgula
CLIENT_ORIGIN=http://localhost:3010,http://localhost:3011,https://ninja.wmst.com.br
# Senha do painel do dono (/api/admin/*, header X-Dev-Key); vazia = painel desligado
DEV_PASSWORD=
# Redis (cache, limites de tentativas, estado do login); vazio = memória do processo
REDIS_URL=redis://localhost:6379
# Login com Discord (discord.com/developers → OAuth2; redirect: <origem>/api/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Login com Google (console.cloud.google.com → Credenciais → ID do cliente OAuth; redirect: <origem>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails que viram admin ao entrar pelo Discord/Google (separados por vírgula)
ADMIN_EMAILS=
# Contato público (privacidade, termos)
CONTACT_EMAIL=
